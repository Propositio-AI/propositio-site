DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
CORS_ORIGINS=http://localhost:5173

# microCMS（活動記録の取得元。https://<MICROCMS_SERVICE_DOMAIN>.microcms.io で発行）
# API: activities（リスト形式） / categories（リスト形式）。スキーマは docs/karynos-site.md 参照
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# メール送信（お問い合わせの運営通知・自動返信）
# console: ログに出力するだけ（開発用） / ses: Amazon SESで送信（本番はECSのタスクロールで認証）
MAIL_BACKEND=console
MAIL_FROM=noreply@propositio.com
# 運営の受信箱（Google Workspace）。通知の宛先と、自動返信のReply-Toに使う
CONTACT_NOTIFY_TO=info@propositio.com
MAIL_REPLY_TO=info@propositio.com
SES_CONFIGURATION_SET=
AWS_REGION=ap-northeast-1

# Cloudflare Turnstile（ボット対策）。空ならスキップ。apps/webのVITE_TURNSTILE_SITE_KEYと対で設定する
TURNSTILE_SECRET_KEY=
