DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
CORS_ORIGINS=http://localhost:5173

# microCMS（活動記録の取得元。https://<MICROCMS_SERVICE_DOMAIN>.microcms.io で発行）
# API: activities（リスト形式） / categories（リスト形式）。スキーマは docs/karynos-site.md 参照
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# メール送信（お問い合わせの運営通知・自動返信）
# console: ログに出力するだけ（開発用） / gmail: Gmail APIで送信（Google Workspace）
MAIL_BACKEND=console
# 送信元のWorkspaceユーザー（例: contact@example.com）
GMAIL_SENDER=
# ドメイン全体の委任（scope: https://www.googleapis.com/auth/gmail.send）を設定したサービスアカウント鍵のJSON（1行）
GMAIL_SERVICE_ACCOUNT_JSON=
# お問い合わせの通知先（例: info@example.com。Googleグループも可）
CONTACT_NOTIFY_TO=

# Cloudflare Turnstile（ボット対策）。空ならスキップ。apps/webのVITE_TURNSTILE_SITE_KEYと対で設定する
TURNSTILE_SECRET_KEY=
