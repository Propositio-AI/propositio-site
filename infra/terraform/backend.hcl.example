# shared / envs/* の terraform init で -backend-config=../backend.hcl（envsは ../../backend.hcl）として渡す。
# cp backend.hcl.example backend.hcl し、propositio-infraのservice_platform_config.state.bucketを記入する。
bucket       = "propositio-terraform-state-123456789012"
region       = "ap-northeast-1"
encrypt      = true
use_lockfile = true
